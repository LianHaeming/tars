#!/usr/bin/env node
// tars-owned Gmail access. Usage:
//   bin/gmail auth            one-time OAuth (authorise from your phone)
//   bin/gmail recent [n]      list the n most recent messages
//   bin/gmail search <query>  Gmail search (Gmail query syntax)
const http = require('http');
const { execSync } = require('child_process');
const g = require('../lib/gmail');

const [cmd, ...rest] = process.argv.slice(2);
const PORT = 8790;

function serveOff() { try { execSync(`tailscale serve --https=${PORT} off`); } catch {} }

function auth() {
  const cbPath = new URL(g.REDIRECT).pathname;
  const server = http.createServer(async (req, res) => {
    const u = new URL(req.url, 'http://x');
    if (u.pathname !== cbPath) { res.writeHead(404); return res.end(); }
    const code = u.searchParams.get('code');
    if (!code) { res.writeHead(400); return res.end('missing code'); }
    try {
      await g.exchangeCode(code);
      res.writeHead(200, { 'content-type': 'text/html' });
      res.end('<h2>tars is connected to Gmail ✅</h2><p>You can close this tab.</p>');
      console.log('\n✅ Saved refresh token to', g.TOKEN);
    } catch (e) {
      res.writeHead(500, { 'content-type': 'text/plain' });
      res.end('Error: ' + e.message);
      console.error('\n❌ ' + e.message);
    } finally {
      setTimeout(() => { serveOff(); server.close(); process.exit(0); }, 400);
    }
  });
  server.listen(PORT, '127.0.0.1', () => {
    try { execSync(`tailscale serve --bg --https=${PORT} http://127.0.0.1:${PORT}`); }
    catch (e) { console.error('tailscale serve failed:', e.message); }
    console.log('1. Open this URL on a device signed into the Google account:\n');
    console.log('   ' + g.authUrl());
    console.log('\n2. Approve access (click through the "unverified app" warning if shown).');
    console.log('3. You will land on a "connected" page. Done.\n\nWaiting for the redirect…');
  });
  process.on('SIGINT', () => { serveOff(); process.exit(1); });
}

async function list(query, n) {
  const msgs = await g.search(query, n);
  if (!msgs.length) return console.log('(no messages)');
  for (const m of msgs) {
    const d = await g.message(m.id);
    const date = (d.headers.date || '').replace(/\s*\(.*\)$/, '').slice(0, 22);
    console.log(`${date.padEnd(22)}  ${(d.headers.subject || '(no subject)').slice(0, 70)}`);
  }
}

(async () => {
  try {
    if (cmd === 'auth') auth();
    else if (cmd === 'recent') await list('', Number(rest[0]) || 10);
    else if (cmd === 'search') await list(rest.join(' '), 25);
    else { console.log('usage: bin/gmail auth | recent [n] | search <query>'); process.exit(1); }
  } catch (e) { console.error('Error:', e.message); process.exit(1); }
})();
