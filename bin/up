#!/usr/bin/env bash
# Usage: bin/up <app>   (apps/<app>/app.json: {"name", "port", "https"?, "build"?, "start"})
# Installs workspace deps when the lockfile changed, builds the app, links apps/<app>/state to the live data in
# ~/tars/apps/<app>/state, (re)starts the tars-<app> user service and serves it on the tailnet over HTTPS.
# Live checkout only: from a worktree it would repoint the service at unmerged code.
set -euo pipefail
TARS="$(cd "$(dirname "$0")/.." && pwd)"
name="$(basename "${1:?usage: bin/up <app>}")"
dir="$TARS/apps/$name"
[ -f "$dir/app.json" ] || { echo "no $dir/app.json" >&2; exit 1; }
. "$TARS/bin/lib/state.sh"
live_only
field() { python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get(sys.argv[2], ""))' "$dir/app.json" "$1"; }
port="$(field port)"; public="$(field https)"; public="${public:-$port}"; start="$(field start)"; build="$(field build)"
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"

link_state "$name"

if [ ! -d "$TARS/node_modules" ] || [ "$TARS/package-lock.json" -nt "$TARS/node_modules/.package-lock.json" ]; then
  (cd "$TARS" && npm ci --no-audit --no-fund --loglevel=error)
fi
if [ -n "$build" ]; then (cd "$dir" && sh -c "$build"); fi

unit="$HOME/.config/systemd/user/tars-$name.service"
mkdir -p "$(dirname "$unit")"
cat > "$unit" <<UNIT
[Unit]
Description=tars: $name

[Service]
WorkingDirectory=$dir
Environment=PORT=$port
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=/bin/sh -c 'exec $start'
Restart=on-failure

[Install]
WantedBy=default.target
UNIT

systemctl --user daemon-reload
systemctl --user enable --quiet "tars-$name.service"
systemctl --user restart "tars-$name.service"
tailscale serve --bg --https="$public" "http://127.0.0.1:$port" >/dev/null
host="$(tailscale status --json | python3 -c 'import json,sys; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))')"
[ "$public" = 443 ] && echo "$name -> https://$host/" || echo "$name -> https://$host:$public/"
