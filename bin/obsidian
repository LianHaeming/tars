#!/usr/bin/env bash
# Obsidian vault sync for tars. Each vault lives at ~/tars/vaults/<name> and is kept in step with Obsidian Sync by
# obsidian-headless (`ob`, npm i -g obsidian-headless), so notes written there reach the Obsidian app on Lian's phone
# within seconds. Vaults: "tars" (tars writes here) and "youtube-digest" (Lian's, read for grounding).
# Usage: bin/obsidian install       one tars-obsidian-<name> user service (`ob sync --continuous`) per vault
#        bin/obsidian status        login, then each vault's config and service state
#        bin/obsidian sync [name]   one-off sync now (stops that vault's service while it runs)
# Sign-in is Lian's to do (it prompts for secrets): `ob login`; per vault
#   ob sync-setup --vault <name> --path ~/tars/vaults/<name> --device-name tars-omarchy
# The session and the vaults' encryption keys live in ~/.config/obsidian-headless (outside the repo).
set -euo pipefail
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"
VAULTS="${TARS_VAULTS:-$HOME/tars/vaults}"

vaults() {
  for d in "$VAULTS"/*/; do
    d="${d%/}"
    ob sync-status --path "$d" >/dev/null 2>&1 && basename "$d"
  done
}

case "${1:-}" in
  install)
    if systemctl --user cat tars-obsidian-sync.service >/dev/null 2>&1; then
      systemctl --user disable --now --quiet tars-obsidian-sync.service
      rm -f "$HOME/.config/systemd/user/tars-obsidian-sync.service"
    fi
    for name in $(vaults); do
      unit="$HOME/.config/systemd/user/tars-obsidian-$name.service"
      mkdir -p "$(dirname "$unit")"
      cat > "$unit" <<UNIT
[Unit]
Description=tars: Obsidian Sync for ~/tars/vaults/$name
After=network-online.target

[Service]
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=/bin/sh -c 'exec ob sync --continuous --path $VAULTS/$name'
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
UNIT
      systemctl --user daemon-reload
      systemctl --user enable --quiet "tars-obsidian-$name.service"
      systemctl --user restart "tars-obsidian-$name.service"
      echo "$name -> tars-obsidian-$name ($(systemctl --user is-active "tars-obsidian-$name.service"))"
    done
    ;;
  status)
    ob login </dev/null
    for name in $(vaults); do
      echo; ob sync-status --path "$VAULTS/$name"
      echo "  Service: tars-obsidian-$name ($(systemctl --user is-active "tars-obsidian-$name.service" 2>/dev/null || true))"
    done
    ;;
  sync)
    for name in ${2:-$(vaults)}; do
      unit="tars-obsidian-$name.service"
      was_active="$(systemctl --user is-active "$unit" 2>/dev/null || true)"
      systemctl --user stop "$unit" 2>/dev/null || true
      ob sync --path "$VAULTS/$name"
      [ "$was_active" = active ] && systemctl --user start "$unit" || true
    done
    ;;
  *)
    sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
