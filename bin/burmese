#!/usr/bin/env node
// Usage: bin/burmese build [N]   (re)write the deck of N everyday sentences (default 100) via `claude -p`; resets their progress.
//        bin/burmese phrases [N]  top up the phrase-of-the-day bank to N phrases (default 365).
//        bin/burmese count       how many sentences are in the deck and how many are learned.
// Stop the service first (systemctl --user stop tars-burmese) — it keeps burmese.json in memory — and start it again after.
const { build } = require('../apps/burmese/server/burmese');
const phrases = require('../apps/burmese/server/phrases');
const { burmese } = require('../apps/burmese/server/state');

const [cmd, arg] = process.argv.slice(2);

if (cmd === 'count') {
  const d = burmese.get();
  console.log(`${(d.deck || []).length} sentences, ${Object.keys(d.progress || {}).length} learned`);
} else if (cmd === 'phrases') {
  phrases.build(Number(arg) || 365, 40, msg => console.log(msg)).then(() => process.exit(0), e => { console.error(e.message); process.exit(1); });
} else if (cmd === 'build') {
  build(Number(arg) || 100, msg => console.log(msg)).then(
    () => process.exit(0),
    e => { console.error('build failed:', e.message); process.exit(1); },
  );
} else {
  console.error('usage: bin/burmese build [N] | phrases [N] | count');
  process.exit(1);
}
