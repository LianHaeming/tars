#!/usr/bin/env node
// Usage: bin/burmese build [category…] [-n N]   (re)write the sentence pool via `claude -p` (all categories by default, N=40 each)
//        bin/burmese count                      sentences per category
// Safe while the service runs: it only writes state/sentences.json, which the server reloads on change.
const { build, pool, CATEGORIES } = require('../apps/burmese/server/content');

const args = process.argv.slice(2);
const cmd = args.shift();
const ni = args.indexOf('-n');
const n = ni >= 0 ? Number(args.splice(ni, 2)[1]) || 40 : 40;

if (cmd === 'count') {
  const { sentences } = pool();
  for (const c of CATEGORIES) console.log(`${c.name}: ${sentences.filter(s => s.cat === c.key).length}`);
  console.log(`total: ${sentences.length}`);
} else if (cmd === 'build') {
  const keys = args.length ? args : CATEGORIES.map(c => c.key);
  const bad = keys.filter(k => !CATEGORIES.some(c => c.key === k));
  if (bad.length) { console.error(`unknown category: ${bad.join(', ')} (have ${CATEGORIES.map(c => c.key).join(', ')})`); process.exit(1); }
  build(keys, n, msg => console.log(msg)).then(
    total => { console.log(`pool: ${total} sentences`); process.exit(0); },
    e => { console.error('build failed:', e.message); process.exit(1); },
  );
} else {
  console.error('usage: bin/burmese build [category…] [-n N] | count');
  process.exit(1);
}
