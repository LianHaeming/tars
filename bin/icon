#!/usr/bin/env bash
# Usage: bin/icon <app> <glyph> [font]   write apps/<app>/web/public/{icon-512,icon-192,apple-touch-icon}.png
# Every app's home-screen icon is the same navy gradient with one white glyph, so the set reads as one family.
set -euo pipefail
TARS="$(cd "$(dirname "$0")/.." && pwd)"
out="$TARS/apps/${1:?usage: bin/icon <app> <glyph> [font]}/web/public"
glyph="${2:?usage: bin/icon <app> <glyph> [font]}"
font="${3:-Inter}"
mkdir -p "$out"
svg="$(mktemp --suffix=.svg)"
trap 'rm -f "$svg"' EXIT
cat > "$svg" <<SVG
<svg xmlns="http://www.w3.org/2000/svg" width="512" height="512" viewBox="0 0 512 512">
  <defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1">
    <stop offset="0" stop-color="#1e4977"/><stop offset="1" stop-color="#0b1119"/>
  </linearGradient></defs>
  <rect width="512" height="512" fill="url(#g)"/>
  <text x="256" y="256" dy=".35em" text-anchor="middle" font-family="$font" font-weight="700" font-size="260" fill="#fff">$glyph</text>
</svg>
SVG
rsvg-convert -w 512 -h 512 "$svg" -o "$out/icon-512.png"
rsvg-convert -w 192 -h 192 "$svg" -o "$out/icon-192.png"
rsvg-convert -w 180 -h 180 "$svg" -o "$out/apple-touch-icon.png"
echo "icons -> $out"
